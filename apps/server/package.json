{
  "name": "@mavio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@mavio/cache": "workspace:*",
    "@mavio/config": "workspace:*",
    "@mavio/core": "workspace:*",
    "@mavio/import-graphql": "workspace:*",
    "@mavio/import-mcp": "workspace:*",
    "@mavio/import-openapi": "workspace:*",
    "@mavio/import-sql": "workspace:*",
    "@mavio/marketplace": "workspace:*",
    "@mavio/observability": "workspace:*",
    "@mavio/plugin": "workspace:*",
    "@mavio/rbac": "workspace:*",
    "@mavio/rbac-opa": "workspace:*",
    "@mavio/registry": "workspace:*",
    "@mavio/registry-external": "workspace:*",
    "@mavio/sdk": "workspace:*",
    "@mavio/transport": "workspace:*",
    "@mavio/upstream-auth": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "ajv": "^8.20.0",
    "cookie": "^0.6.0",
    "kysely": "^0.27.4",
    "openid-client": "^5.7.0",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^6.19.8",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.22",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.5.12",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  }
