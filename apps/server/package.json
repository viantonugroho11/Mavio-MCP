{
  "name": "@mavio/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@mavio/cache": "workspace:*",
    "@mavio/config": "workspace:*",
    "@mavio/core": "workspace:*",
    "@mavio/import-openapi": "workspace:*",
    "@mavio/rbac": "workspace:*",
    "@mavio/registry": "workspace:*",
    "@mavio/transport": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "undici": "^6.19.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4"
  }
}
